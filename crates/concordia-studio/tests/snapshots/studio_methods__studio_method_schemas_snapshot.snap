  {
    "docs": "Studio activity from the Studio journal (task changes, reviews, file edits by agents), oldest first.",
    "mutates": false,
    "name": "studio.activity",
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`studio.activity` params.",
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "Only this actor, e.g. \"agent:level-designer#1\"."
        },
        "kind": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "Only this kind: task_created, task_changed, task_comment, task_review, file_edit, sync."
        },
        "limit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "description": "Maximum entries (default 100).",
          "maximum": 1000.0,
          "minimum": 1.0
        },
        "role": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "Only agents in this role, e.g. \"level-designer\"."
        },
        "since": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "description": "Only entries after this seq (use `next` from the last call)."
        },
        "task": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "Only this task."
        }
      },
      "title": "StudioActivityParams",
      "type": "object",
      "x-concordia-type": "StudioActivityParams"
    }
  },
  {
    "docs": "Regenerate the Claude Code files (.claude/agents, .claude/skills, settings hooks, .mcp.json, the CLAUDE.md block) from studio/.",
