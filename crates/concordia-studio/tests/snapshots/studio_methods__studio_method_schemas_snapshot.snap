  {
    "docs": "Reject a task in review with a reason: in_review → rejected (blocked for a human after too many attempts).",
    "mutates": true,
    "name": "task.reject",
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
