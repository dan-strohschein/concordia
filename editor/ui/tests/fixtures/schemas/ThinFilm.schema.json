{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A thin dielectric film on the interface (soap bubbles, oil, anodized metal).",
  "properties": {
    "ior": {
      "description": "Film index of refraction.",
      "maximum": 3.0,
      "minimum": 1.0,
      "type": "number"
    },
    "thickness_nm": {
      "description": "Film thickness in nanometres.",
      "maximum": 2000.0,
      "minimum": 0.0,
      "type": "number"
    }
  },
  "required": [
    "thickness_nm",
    "ior"
  ],
  "title": "ThinFilm",
  "type": "object",
  "x-concordia-type": "ThinFilm"
}
