{
  "$defs": {
    "Distribution": {
      "description": "How a spawner arranges its entities around its transform.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A square grid on the XZ plane, `spacing` meters apart, centered.",
          "properties": {
            "Grid": {
              "additionalProperties": false,
              "properties": {
                "spacing": {
                  "description": "Meters between neighbors.",
                  "type": "number"
                }
              },
              "required": [
                "spacing"
              ],
              "type": "object"
            }
          },
          "required": [
            "Grid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Uniformly in a box of these half extents.",
          "properties": {
            "Box": {
              "additionalProperties": false,
              "properties": {
                "half_extents": {
                  "description": "Half size on each axis, in meters.\n\n3D vector as [x, y, z].",
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array",
                  "x-concordia-widget": "vec3"
                }
              },
              "required": [
                "half_extents"
              ],
              "type": "object"
            }
          },
          "required": [
            "Box"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Uniformly in a disc of this radius on the XZ plane.",
          "properties": {
            "Disc": {
              "additionalProperties": false,
              "properties": {
                "radius": {
                  "description": "Radius in meters.",
                  "type": "number"
                }
              },
              "required": [
                "radius"
              ],
              "type": "object"
            }
          },
          "required": [
            "Disc"
          ],
          "type": "object"
        }
      ],
      "title": "Distribution",
      "x-concordia-type": "Distribution"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Places `count` entities of `template` when play starts (the edit world keeps only this).",
  "properties": {
    "count": {
      "description": "How many entities (1 to 1,000,000).",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "distribution": {
      "$ref": "#/$defs/Distribution",
      "description": "Where they go, relative to the spawner's transform."
    },
    "seed": {
      "description": "Seed for the distribution and the spawned ids.",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "template": {
      "description": "Template name (see entity.templates).",
      "type": "string"
    }
  },
  "required": [
    "template",
    "count",
    "seed",
    "distribution"
  ],
  "title": "Spawner",
  "type": "object",
  "x-concordia-category": "Simulation",
  "x-concordia-type": "Spawner"
}
