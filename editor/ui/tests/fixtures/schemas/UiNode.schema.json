{
  "$defs": {
    "Align": {
      "description": "Alignment across an axis.",
      "oneOf": [
        {
          "const": "Stretch",
          "description": "Filling the line."
        },
        {
          "const": "Start",
          "description": "At the start."
        },
        {
          "const": "End",
          "description": "At the end."
        },
        {
          "const": "Center",
          "description": "Centered."
        }
      ],
      "title": "Align",
      "x-concordia-type": "Align"
    },
    "Anchored": {
      "additionalProperties": false,
      "default": {
        "anchors": {
          "bottom": 0.0,
          "left": 0.0,
          "right": 0.0,
          "top": 0.0
        },
        "grow_h": "End",
        "grow_v": "End",
        "offsets": {
          "bottom": 0.0,
          "left": 0.0,
          "right": 0.0,
          "top": 0.0
        }
      },
      "description": "Godot-style anchors: each edge sits at `anchor × parent size + offset`.",
      "properties": {
        "anchors": {
          "$ref": "#/$defs/Edges",
          "description": "Anchor fractions of the parent (0..1)."
        },
        "grow_h": {
          "$ref": "#/$defs/Grow",
          "description": "Which side moves when the rect is narrower than the minimum width."
        },
        "grow_v": {
          "$ref": "#/$defs/Grow",
          "description": "Which side moves when the rect is shorter than the minimum height."
        },
        "offsets": {
          "$ref": "#/$defs/Edges",
          "description": "Pixel offsets from the anchors."
        }
      },
      "title": "Anchored",
      "type": "object",
      "x-concordia-type": "Anchored"
    },
    "Direction": {
      "description": "A flex main axis.",
      "oneOf": [
        {
          "const": "Row",
          "description": "Left to right."
        },
        {
          "const": "Column",
          "description": "Top to bottom."
        },
        {
          "const": "RowReverse",
          "description": "Right to left."
        },
        {
          "const": "ColumnReverse",
          "description": "Bottom to top."
        }
      ],
      "title": "Direction",
      "x-concordia-type": "Direction"
    },
    "Edges": {
      "additionalProperties": false,
      "default": {
        "bottom": 0.0,
        "left": 0.0,
        "right": 0.0,
        "top": 0.0
      },
      "description": "A value per side.",
      "properties": {
        "bottom": {
          "description": "Bottom.",
          "type": "number"
        },
        "left": {
          "description": "Left.",
          "type": "number"
        },
        "right": {
          "description": "Right.",
          "type": "number"
        },
        "top": {
          "description": "Top.",
          "type": "number"
        }
      },
      "title": "Edges",
      "type": "object",
      "x-concordia-type": "Edges"
    },
    "Flex": {
      "additionalProperties": false,
      "default": {
        "align_content": "Start",
        "align_items": "Stretch",
        "direction": "Row",
        "justify": "Start",
        "wrap": false
      },
      "description": "Flexbox settings.",
      "properties": {
        "align_content": {
          "$ref": "#/$defs/Justify",
          "description": "Placement of wrapped lines."
        },
        "align_items": {
          "$ref": "#/$defs/Align",
          "description": "Placement across it."
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "description": "The main axis."
        },
        "justify": {
          "$ref": "#/$defs/Justify",
          "description": "Placement along the main axis."
        },
        "wrap": {
          "description": "Wrap onto more lines.",
          "type": "boolean"
        }
      },
      "title": "Flex",
      "type": "object",
      "x-concordia-type": "Flex"
    },
    "Grid": {
      "additionalProperties": false,
      "default": {
        "align_items": "Stretch",
        "columns": [],
        "justify_items": "Stretch",
        "rows": []
      },
      "description": "Grid settings.",
      "properties": {
        "align_items": {
          "$ref": "#/$defs/Align",
          "description": "Cell alignment across rows."
        },
        "columns": {
          "description": "Column tracks (children fill row by row).",
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        },
        "justify_items": {
          "$ref": "#/$defs/Align",
          "description": "Cell alignment across columns."
        },
        "rows": {
          "description": "Row tracks (more rows are added at `Auto`).",
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        }
      },
      "title": "Grid",
      "type": "object",
      "x-concordia-type": "Grid"
    },
    "Grow": {
      "description": "Which way a too-small anchored rect grows.",
      "oneOf": [
        {
          "const": "Begin",
          "description": "Toward the left or top."
        },
        {
          "const": "End",
          "description": "Toward the right or bottom."
        },
        {
          "const": "Both",
          "description": "Both ways, about the center."
        }
      ],
      "title": "Grow",
      "x-concordia-type": "Grow"
    },
    "Justify": {
      "description": "Distribution along an axis.",
      "oneOf": [
        {
          "const": "Start",
          "description": "Packed at the start."
        },
        {
          "const": "End",
          "description": "Packed at the end."
        },
        {
          "const": "Center",
          "description": "Centered."
        },
        {
          "const": "SpaceBetween",
          "description": "Even gaps between, none at the ends."
        },
        {
          "const": "SpaceAround",
          "description": "Half gaps at the ends."
        },
        {
          "const": "SpaceEvenly",
          "description": "Equal gaps everywhere."
        }
      ],
      "title": "Justify",
      "x-concordia-type": "Justify"
    },
    "Layout": {
      "description": "How a node lays out its in-flow children.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "CSS Flexbox.",
          "properties": {
            "Flex": {
              "$ref": "#/$defs/Flex"
            }
          },
          "required": [
            "Flex"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "CSS Grid with explicit tracks.",
          "properties": {
            "Grid": {
              "$ref": "#/$defs/Grid"
            }
          },
          "required": [
            "Grid"
          ],
          "type": "object"
        },
        {
          "const": "Stack",
          "description": "Children overlap, each filling the content box (like Godot's `PanelContainer`)."
        }
      ],
      "title": "Layout",
      "x-concordia-type": "Layout"
    },
    "Length": {
      "description": "A length along one axis.",
      "oneOf": [
        {
          "const": "Auto",
          "description": "From the content or the layout."
        },
        {
          "additionalProperties": false,
          "description": "Logical pixels (≥ 0).",
          "properties": {
            "Px": {
              "type": "number"
            }
          },
          "required": [
            "Px"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Percent of the parent's content box (0..100).",
          "properties": {
            "Percent": {
              "type": "number"
            }
          },
          "required": [
            "Percent"
          ],
          "type": "object"
        }
      ],
      "title": "Length",
      "x-concordia-type": "Length"
    },
    "Position": {
      "description": "Where a node goes: in its parent's flow, or pinned by anchors.",
      "oneOf": [
        {
          "const": "InFlow",
          "description": "Laid out by the parent's layout."
        },
        {
          "additionalProperties": false,
          "description": "Pinned inside the parent by anchors and offsets.",
          "properties": {
            "Anchored": {
              "$ref": "#/$defs/Anchored"
            }
          },
          "required": [
            "Anchored"
          ],
          "type": "object"
        }
      ],
      "title": "Position",
      "x-concordia-type": "Position"
    },
    "Track": {
      "description": "A grid track's size.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Logical pixels.",
          "properties": {
            "Px": {
              "type": "number"
            }
          },
          "required": [
            "Px"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A share of the free space.",
          "properties": {
            "Fr": {
              "type": "number"
            }
          },
          "required": [
            "Fr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Percent of the grid's content box.",
          "properties": {
            "Percent": {
              "type": "number"
            }
          },
          "required": [
            "Percent"
          ],
          "type": "object"
        },
        {
          "const": "Auto",
          "description": "Fits its content."
        }
      ],
      "title": "Track",
      "x-concordia-type": "Track"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "default": {
    "clip": false,
    "gap": [
      0.0,
      0.0
    ],
    "grow": 0.0,
    "height": "Auto",
    "layout": {
      "Flex": {
        "align_content": "Start",
        "align_items": "Stretch",
        "direction": "Row",
        "justify": "Start",
        "wrap": false
      }
    },
    "margin": {
      "bottom": 0.0,
      "left": 0.0,
      "right": 0.0,
      "top": 0.0
    },
    "max_height": "Auto",
    "max_width": "Auto",
    "min_height": "Auto",
    "min_width": "Auto",
    "order": 0,
    "padding": {
      "bottom": 0.0,
      "left": 0.0,
      "right": 0.0,
      "top": 0.0
    },
    "position": "InFlow",
    "shrink": 1.0,
    "visible": true,
    "width": "Auto",
    "z": 0
  },
  "description": "A widget's box.",
  "properties": {
    "clip": {
      "description": "Clips the children to this box.",
      "type": "boolean"
    },
    "gap": {
      "description": "Gaps between children `[column, row]`.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "grow": {
      "description": "Flex grow factor.",
      "maximum": 1000.0,
      "minimum": 0.0,
      "type": "number"
    },
    "height": {
      "$ref": "#/$defs/Length",
      "description": "Height (ignored when anchored)."
    },
    "layout": {
      "$ref": "#/$defs/Layout",
      "description": "How the children lay out."
    },
    "margin": {
      "$ref": "#/$defs/Edges",
      "description": "Space outside the box."
    },
    "max_height": {
      "$ref": "#/$defs/Length",
      "description": "Maximum height."
    },
    "max_width": {
      "$ref": "#/$defs/Length",
      "description": "Maximum width."
    },
    "min_height": {
      "$ref": "#/$defs/Length",
      "description": "Minimum height."
    },
    "min_width": {
      "$ref": "#/$defs/Length",
      "description": "Minimum width."
    },
    "order": {
      "description": "Sibling order (then entity id).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "padding": {
      "$ref": "#/$defs/Edges",
      "description": "Space inside the box, around the children."
    },
    "position": {
      "$ref": "#/$defs/Position",
      "description": "In flow, or anchored."
    },
    "shrink": {
      "description": "Flex shrink factor.",
      "maximum": 1000.0,
      "minimum": 0.0,
      "type": "number"
    },
    "visible": {
      "description": "Drawn and laid out.",
      "type": "boolean"
    },
    "width": {
      "$ref": "#/$defs/Length",
      "description": "Width (ignored when anchored)."
    },
    "z": {
      "description": "Draw order among siblings (higher on top).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    }
  },
  "title": "UiNode",
  "type": "object",
  "x-concordia-category": "UI",
  "x-concordia-type": "UiNode"
}
