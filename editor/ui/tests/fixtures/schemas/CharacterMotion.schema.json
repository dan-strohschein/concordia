{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "default": {
    "velocity": [
      0.0,
      0.0,
      0.0
    ]
  },
  "description": "Desired horizontal velocity of a character this tick (gameplay writes it; y is ignored).",
  "properties": {
    "velocity": {
      "description": "Meters per second.\n\n3D vector as [x, y, z].",
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "x-concordia-widget": "vec3"
    }
  },
  "title": "CharacterMotion",
  "type": "object",
  "x-concordia-category": "Physics",
  "x-concordia-type": "CharacterMotion"
}
