{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "default": {
    "center": [
      0.5,
      0.5
    ],
    "start_deg": 0.0,
    "sweep_deg": 360.0
  },
  "description": "The radial fill's geometry.",
  "properties": {
    "center": {
      "description": "The pivot as fractions of the box.",
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "start_deg": {
      "description": "Where the fill starts, in degrees clockwise from up.",
      "type": "number"
    },
    "sweep_deg": {
      "description": "The full sweep in degrees (0..360].",
      "type": "number"
    }
  },
  "title": "RadialFill",
  "type": "object",
  "x-concordia-type": "RadialFill"
}
