{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "How a body moves.",
  "oneOf": [
    {
      "const": "Static",
      "description": "Never moves (ground, walls)."
    },
    {
      "const": "Dynamic",
      "description": "Moved by the simulation."
    },
    {
      "const": "Kinematic",
      "description": "Follows its `Transform`, pushing dynamic bodies."
    }
  ],
  "title": "BodyKind",
  "x-concordia-type": "BodyKind"
}
