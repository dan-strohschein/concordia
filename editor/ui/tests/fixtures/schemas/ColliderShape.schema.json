{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A collision shape, centered on the entity (plus the collider's offset).",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "A box.",
      "properties": {
        "Box": {
          "additionalProperties": false,
          "properties": {
            "half_extents": {
              "description": "Half the size along each axis, in meters.\n\n3D vector as [x, y, z].",
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array",
              "x-concordia-widget": "vec3"
            }
          },
          "required": [
            "half_extents"
          ],
          "type": "object"
        }
      },
      "required": [
        "Box"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A sphere.",
      "properties": {
        "Sphere": {
          "additionalProperties": false,
          "properties": {
            "radius": {
              "description": "Radius in meters.",
              "type": "number"
            }
          },
          "required": [
            "radius"
          ],
          "type": "object"
        }
      },
      "required": [
        "Sphere"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A Y-aligned capsule.",
      "properties": {
        "Capsule": {
          "additionalProperties": false,
          "properties": {
            "half_height": {
              "description": "Half the height of the cylindrical part.",
              "type": "number"
            },
            "radius": {
              "description": "Radius.",
              "type": "number"
            }
          },
          "required": [
            "half_height",
            "radius"
          ],
          "type": "object"
        }
      },
      "required": [
        "Capsule"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A Y-aligned cylinder.",
      "properties": {
        "Cylinder": {
          "additionalProperties": false,
          "properties": {
            "half_height": {
              "description": "Half the height.",
              "type": "number"
            },
            "radius": {
              "description": "Radius.",
              "type": "number"
            }
          },
          "required": [
            "half_height",
            "radius"
          ],
          "type": "object"
        }
      },
      "required": [
        "Cylinder"
      ],
      "type": "object"
    }
  ],
  "title": "ColliderShape",
  "x-concordia-type": "ColliderShape"
}
