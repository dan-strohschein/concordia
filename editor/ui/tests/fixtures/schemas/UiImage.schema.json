{
  "$defs": {
    "ImageMode": {
      "description": "How an image fills its box (Godot's `TextureRect` stretch modes).",
      "oneOf": [
        {
          "const": "Scale",
          "description": "Stretched to the box."
        },
        {
          "const": "Tile",
          "description": "Repeated from the top left at its own size."
        },
        {
          "const": "Keep",
          "description": "Its own size at the top left."
        },
        {
          "const": "KeepCentered",
          "description": "Its own size, centered."
        },
        {
          "const": "KeepAspect",
          "description": "Scaled to fit inside, at the top left."
        },
        {
          "const": "KeepAspectCentered",
          "description": "Scaled to fit inside, centered."
        },
        {
          "const": "KeepAspectCovered",
          "description": "Scaled to cover the box, centered and cropped."
        }
      ],
      "title": "ImageMode",
      "x-concordia-type": "ImageMode"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A picture.",
  "properties": {
    "flip_h": {
      "description": "Mirrored left to right.",
      "type": "boolean"
    },
    "flip_v": {
      "description": "Mirrored top to bottom.",
      "type": "boolean"
    },
    "image": {
      "description": "The texture asset.\n\nAsset reference: \"asset:<uuid>\", \"asset:<uuid>#<sub-path>\" or \"builtin:<kind>/<name>\" (see asset.list).",
      "pattern": "^(asset:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(#.+)?|builtin:[a-z]+/[a-z0-9_]+)$",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ImageMode",
      "description": "How it fills the box."
    },
    "region": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ],
      "description": "A sub-rect `[x, y, w, h]` in texture pixels (none: all of it)."
    },
    "tint": {
      "description": "Linear RGBA multiplier.",
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "x-concordia-widget": "color"
    }
  },
  "required": [
    "image"
  ],
  "title": "UiImage",
  "type": "object",
  "x-concordia-category": "UI",
  "x-concordia-type": "UiImage"
}
