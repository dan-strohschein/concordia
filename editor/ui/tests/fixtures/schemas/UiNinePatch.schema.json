{
  "$defs": {
    "AxisStretch": {
      "description": "How a nine-patch's edges and center fill their spans.",
      "oneOf": [
        {
          "const": "Stretch",
          "description": "Stretched."
        },
        {
          "const": "Tile",
          "description": "Repeated, the last tile cut."
        },
        {
          "const": "TileFit",
          "description": "Repeated a whole number of times, scaled to fit."
        }
      ],
      "title": "AxisStretch",
      "x-concordia-type": "AxisStretch"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A picture cut into nine parts whose corners keep their size (Godot's `NinePatchRect`).",
  "properties": {
    "axis_h": {
      "$ref": "#/$defs/AxisStretch",
      "description": "Horizontal edges and center."
    },
    "axis_v": {
      "$ref": "#/$defs/AxisStretch",
      "description": "Vertical edges and center."
    },
    "draw_center": {
      "description": "Draws the center part.",
      "type": "boolean"
    },
    "image": {
      "description": "The texture asset.\n\nAsset reference: \"asset:<uuid>\", \"asset:<uuid>#<sub-path>\" or \"builtin:<kind>/<name>\" (see asset.list).",
      "pattern": "^(asset:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(#.+)?|builtin:[a-z]+/[a-z0-9_]+)$",
      "type": "string"
    },
    "margins": {
      "description": "The fixed borders in texture pixels: left, top, right, bottom.",
      "items": {
        "maximum": 4294967295,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "region": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ],
      "description": "A sub-rect `[x, y, w, h]` in texture pixels (none: all of it)."
    },
    "tint": {
      "description": "Linear RGBA multiplier.",
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "x-concordia-widget": "color"
    }
  },
  "required": [
    "image",
    "margins"
  ],
  "title": "UiNinePatch",
  "type": "object",
  "x-concordia-category": "UI",
  "x-concordia-type": "UiNinePatch"
}
