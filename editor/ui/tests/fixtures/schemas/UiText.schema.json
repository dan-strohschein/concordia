{
  "$defs": {
    "Overflow": {
      "description": "What text past the box does.",
      "oneOf": [
        {
          "const": "Visible",
          "description": "Drawn anyway."
        },
        {
          "const": "Clip",
          "description": "Cut at the box."
        },
        {
          "const": "Ellipsis",
          "description": "The last line that fits ends with \"…\"."
        }
      ],
      "title": "Overflow",
      "x-concordia-type": "Overflow"
    },
    "TextAlign": {
      "description": "Horizontal text alignment.",
      "oneOf": [
        {
          "const": "Start",
          "description": "The start edge."
        },
        {
          "const": "Center",
          "description": "Centered."
        },
        {
          "const": "End",
          "description": "The end edge."
        },
        {
          "const": "Justify",
          "description": "Both edges (the last line starts)."
        }
      ],
      "title": "TextAlign",
      "x-concordia-type": "TextAlign"
    },
    "TextRun": {
      "additionalProperties": false,
      "default": {
        "color": null,
        "font": null,
        "italic": null,
        "size": null,
        "text": "",
        "underline": false,
        "weight": null
      },
      "description": "A run of text with its own look; unset fields come from the widget's style.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            }
          ],
          "description": "Linear RGBA."
        },
        "font": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "description": "Asset reference: \"asset:<uuid>\", \"asset:<uuid>#<sub-path>\" or \"builtin:<kind>/<name>\" (see asset.list).",
              "pattern": "^(asset:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(#.+)?|builtin:[a-z]+/[a-z0-9_]+)$",
              "type": "string"
            }
          ],
          "description": "The font family."
        },
        "italic": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "Italic."
        },
        "size": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ],
          "description": "The size in logical pixels."
        },
        "text": {
          "description": "The text.",
          "type": "string"
        },
        "underline": {
          "description": "Underlined.",
          "type": "boolean"
        },
        "weight": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ],
          "description": "The weight (100..900)."
        }
      },
      "title": "TextRun",
      "type": "object",
      "x-concordia-type": "TextRun"
    },
    "VAlign": {
      "description": "Vertical text alignment in the box.",
      "oneOf": [
        {
          "const": "Top",
          "description": "The top."
        },
        {
          "const": "Center",
          "description": "Centered."
        },
        {
          "const": "Bottom",
          "description": "The bottom."
        }
      ],
      "title": "VAlign",
      "x-concordia-type": "VAlign"
    },
    "Wrap": {
      "description": "Where lines may break.",
      "oneOf": [
        {
          "const": "None",
          "description": "Only at newlines."
        },
        {
          "const": "Word",
          "description": "At word boundaries (UAX #14)."
        },
        {
          "const": "Anywhere",
          "description": "Anywhere, when a word doesn't fit."
        }
      ],
      "title": "Wrap",
      "x-concordia-type": "Wrap"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "default": {
    "align": "Start",
    "line_height": 1.0,
    "max_lines": null,
    "overflow": "Visible",
    "runs": [],
    "valign": "Top",
    "wrap": "Word"
  },
  "description": "A label: styled runs, shaped, wrapped and aligned in the box.",
  "properties": {
    "align": {
      "$ref": "#/$defs/TextAlign",
      "description": "Horizontal alignment."
    },
    "line_height": {
      "description": "Line height as a multiple of the font's (0.5..4).",
      "maximum": 4.0,
      "minimum": 0.5,
      "type": "number"
    },
    "max_lines": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "At most this many lines (none: unlimited)."
    },
    "overflow": {
      "$ref": "#/$defs/Overflow",
      "description": "Past the box."
    },
    "runs": {
      "description": "The runs, in order.",
      "items": {
        "$ref": "#/$defs/TextRun"
      },
      "type": "array"
    },
    "valign": {
      "$ref": "#/$defs/VAlign",
      "description": "Vertical alignment."
    },
    "wrap": {
      "$ref": "#/$defs/Wrap",
      "description": "Line breaking."
    }
  },
  "title": "UiText",
  "type": "object",
  "x-concordia-category": "UI",
  "x-concordia-type": "UiText"
}
