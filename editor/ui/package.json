{
  "name": "concordia-editor-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Concordia editor panels: an Engine API client (React, TypeScript).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "schemas": "node scripts/gen-schemas.mjs",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
